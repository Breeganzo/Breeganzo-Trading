# ============================================================================
# QuantDesk Pro — .gitignore
# ============================================================================

# ── Environment ──
.env
.env.local
.env.production
.env.*.local
*.env

# ── Python ──
__pycache__/
*.py[cod]
*$py.class
*.so
venv/
.venv/
*.egg-info/
dist/
build/

# ── Node.js ──
node_modules/
.next/
out/
.vercel/

# ── IDE ──
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Build artifacts ──
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Test ──
htmlcov/
.coverage
.pytest_cache/

# ── Database ──
*.db
*.sqlite3

# ── Secrets ──
*.pem
*.key
*.crt
