# ═══════════════════════════════════════════════════════════════
# Masters AI Trading Bot — Environment Configuration Template
# ═══════════════════════════════════════════════════════════════
# Copy this to .env and fill in your real values:
#   cp .env.example .env
#
# IMPORTANT: Never commit your .env file to version control.
# ═══════════════════════════════════════════════════════════════

# ── Groq API (required for AI explanations) ─────────────────
# Get your free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_API_KEY_2=
GROQ_API_KEY_3=
# Optional comma-separated additional keys:
# GROQ_API_KEYS=key4,key5
# Optional model selection:
GROQ_MODEL=llama-3.3-70b-versatile
# Optional prioritized fallback chain (comma-separated):
# GROQ_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant
# Enable automatic key rotation/failover:
GROQ_KEY_ROTATION_ENABLED=1

# ── Flask ───────────────────────────────────────────────────
FLASK_PORT=5001
FLASK_DEBUG=false
# Generate a unique secret key:
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-this-to-a-random-hex-string

# ── Data / Model / Cache directories ────────────────────────
DATA_DIR=data
MODEL_DIR=models
CACHE_DIR=cache
